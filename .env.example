# ---- DeepSeek（大脑 / 机器评审 / 默认 plan 工人都用它）----
DEEPSEEK_API_KEY="your key"
# 各角色模型可单独配（AGENT_BRAIN/WORKER/CRITIC_MODEL）；不配时缺省取 LLM_MODEL，再缺省 deepseek-chat
LLM_MODEL="deepseek-v4-flash"

# ---- 大脑：本轮固定 DeepSeek 云端（ReAct + 原生 function calling）----
# AGENT_BRAIN_MODEL="deepseek-chat"

# ---- plan/渲染工人：默认 deepseek；qwen = 本地 Qwen3-8B(+LoRA)，协议不变（仅 chat）----
# AGENT_WORKER_PROVIDER="deepseek"        # deepseek | qwen
# AGENT_WORKER_MODEL="deepseek-chat"      # worker_provider=deepseek 时生效
# AGENT_WORKER_LORA="/path/to/lora/adapter"  # worker_provider=qwen 时的 adapter 目录

# ---- 机器评审（固定 deepseek，与规划解耦，防「盖章式通过」）----
# AGENT_CRITIC_MODEL="deepseek-chat"

# ---- 生图后端（环境能力分层）----
# 留空 = 无生图能力 → 注册的工具集里就没有 generate（干跑 / 只出提示词的验证方式）。
# AGENT_IMAGE_MODEL="zimage"      # 或 flux / 本地完整模型 id（见 generation/factory）
# AGENT_OUTPUT_DIR="outputs"      # 图片输出目录

# 会话结束无预算上限：main 即主循环，结束于你输入 exit / 整场对话超出上下文 / 大脑连续传输失败交回你。
# GPU：只有 worker 用本地 qwen、或启用了本地生图后端时才需要显存。
# 物理卡映射在 main.py 顶部的 CUDA_VISIBLE_DEVICES 里改（换卡只改那里）。
